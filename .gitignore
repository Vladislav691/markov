```gitignore
# =========================
# Prerequisites
# =========================
*.d


# =========================
# Compiled object files
# =========================
*.slo
*.lo
*.o
*.obj


# =========================
# Precompiled headers
# =========================
*.gch
*.pch


# =========================
# Linker files
# =========================
*.ilk


# =========================
# Debugger files
# =========================
*.pdb
*.dwo


# =========================
# Dynamic libraries
# =========================
*.so
*.so.*
*.dylib
*.dll


# =========================
# Fortran module files
# =========================
*.mod
*.smod


# =========================
# Static libraries
# =========================
*.lai
*.la
*.a
*.lib


# =========================
# Executables
# =========================
*.exe
*.out
*.app


# =========================
# Build directories
# =========================
build/
Build/
build-*/
cmake-build-*/
out/
bin/
obj/
Debug/
Release/
x64/
x86/


# =========================
# CMake generated files
# =========================
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
CMakeScripts/
CMakeUserPresets.json


# =========================
# Ninja
# =========================
.ninja_deps
.ninja_log
build.ninja
rules.ninja


# =========================
# Qt / Qt Creator
# =========================
*.pro.user
*.pro.user.*
*.qbs.user
*.qbs.user.*
*.qmlproject.user
*.qmlproject.user.*
*.creator.user
*.autosave

# Qt generated files
moc_*.cpp
moc_*.h
ui_*.h
qrc_*.cpp
.qmake.stash
.qmake.cache
Makefile.*
object_script.*


# =========================
# CLion / JetBrains
# =========================
.idea/
*.iml


# =========================
# Visual Studio
# =========================
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.VC.db
*.VC.VC.opendb
ipch/


# =========================
# Visual Studio Code
# =========================
.vscode/

# Если хочешь хранить общие настройки VS Code в Git,
# убери строку ".vscode/" выше и используй, например:
# .vscode/*
# !.vscode/settings.json
# !.vscode/tasks.json
# !.vscode/launch.json
# !.vscode/extensions.json


# =========================
# Temporary files
# =========================
*.tmp
*.temp
*.log
*.bak
*.swp
*.swo
*~
*.orig


# =========================
# vcpkg
# =========================
vcpkg_installed/


# =========================
# Test output & cache
# =========================
Testing/
.cache/
.pytest_cache/
coverage/
*.gcda
*.gcno
*.gcov


# =========================
# Operating system files
# =========================

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
.directory
.Trash-*
```
